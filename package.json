{
  "name": "repopilot",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Checks a repository for readiness and links every finding to its source.",
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "check": "node src/cli/main.ts check",
    "typecheck": "tsc && tsc -p tsconfig.web.json --noEmit",
    "build:web": "tsc -p tsconfig.web.json",
    "demo": "npm run build:web && node scripts/serve.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "verify": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
